{
  "markdown.copyFiles.destination": {
    // "**/*": "${documentDirName}/img/paste-${unixTime}.png"
    "**/*": "./img/paste-${unixTime}.png"
  },
  "workbench.editorAssociations": {
    "*.md": "default",
    "*.markdown": "default"
  },
  "latex-workshop.formatting.latex": "latexindent",
  // Treat codebox as verbatim so latexindent never re-indents Python code
  "latex-workshop.formatting.latexindent.args": [
    "-c",
    "%DIR%/",
    "%TMPFILE%",
    "-y=defaultIndent: '%INDENT%',verbatimEnvironments:codebox:1"
  ],
  "pasteImage.insertPattern": "\\rimg{img/${imageFileName}}{}",
  "pasteImage.path": "${currentFileDir}/img"
}